# ============================================================
#  Copie este arquivo para ".env" e preencha os valores.
#  NUNCA envie o arquivo .env para o GitHub.
# ============================================================

# Conexão com o banco Postgres (Neon, Supabase, etc.)
# Exemplo Neon: postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://chat:chat@localhost:5432/chat

# Segredo usado para assinar a sessão (mínimo 32 caracteres).
# Gere um com:  npm run gerar-segredo
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-caracteres

# ----- Os dois usuários (fixos, não existe cadastro) -----
# LOGIN = o que a pessoa digita na tela de entrada (sem espaços, tanto faz maiúscula/minúscula)
# NOME  = como aparece no chat
USER1_LOGIN=voce
USER1_NOME=Você
USER1_SENHA=troque-esta-senha-1

USER2_LOGIN=esposa
USER2_NOME=Amor
USER2_SENHA=troque-esta-senha-2

# ----- Opcionais -----
# PORT=3000
# NODE_ENV=production     (em produção/hospedagem)
# DATABASE_SSL=false      (só se o seu banco não usa SSL; o padrão liga SSL fora do localhost)
